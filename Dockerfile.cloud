# AskMyRepo for Cloud Run: the models and ShopLite's demo database are baked in (see GCP_setup.md).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    ASKMYREPO_DATABASE=/data/shoplite.db HF_HOME=/models HF_HUB_DISABLE_XET=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# Download both models into the image, so a cold start doesn't fetch 2.4 GB.
RUN python -c "from huggingface_hub import snapshot_download as d; d('Qwen/Qwen3-Embedding-0.6B'); d('Qwen/Qwen3-Reranker-0.6B')"

COPY askmyrepo ./askmyrepo
COPY app.py serve.py corpus.toml ./
COPY index ./index
COPY data/shoplite.db /data/shoplite.db
RUN uv sync --frozen --no-dev

EXPOSE 8501
# serve.py loads both models in the background, then starts Streamlit (no visitor waits for them).
CMD ["python", "serve.py"]
