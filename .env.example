# Copy to .env and fill in. Never commit .env.

# Required
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (answers and the judge)
PINECONE_API_KEY=          # https://app.pinecone.io (the vector index)

# Optional: model names (defaults shown)
# ASKMYREPO_MODEL=gemini-3.5-flash-lite
# ASKMYREPO_JUDGE_MODEL=gemini-3.5-flash-lite

# Optional: path to ShopLite's SQLite file (default: ../shoplite/instance/shoplite.db)
# ASKMYREPO_DATABASE=../shoplite/instance/shoplite.db

# Optional: Langfuse tracing (off when empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional: a Hugging Face token speeds up the first model download
# HF_TOKEN=
