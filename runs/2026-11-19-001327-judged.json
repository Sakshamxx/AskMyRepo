          },
          {
            "claim": 2,
            "supported": true,
            "quote": "CREATE TABLE IF NOT EXISTS stock_levels (\n    sku        TEXT PRIMARY KEY,\n    on_hand    INTEGER NOT NULL CHECK (on_hand >= 0),\n    updated_at TEXT NOT NULL\n);"
          },
          {
            "claim": 3,
            "supported": true,
            "quote": "CREATE TABLE IF NOT EXISTS sync_log (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    sku         TEXT NOT NULL,\n    old_on_hand INTEGER,\n    new_on_hand INTEGER NOT NULL,\n    received_at TEXT NOT NULL\n);"
          },
          {
            "claim": 4,
            "supported": true,
            "quote": "with conn:  # one transaction for both writes\n        conn.execute(\n            \"INSERT INTO stock_levels (sku, on_hand, updated_at) VALUES (?, ?, ?) \"\n            \"ON CONFLICT(sku) DO UPDATE SET on_hand = excluded.on_hand, \"\n            \"updated_at = excluded.updated_at\",\n            (sku, on_hand, now))\n        conn.execute(\n            \"INSERT INTO sync_log (sku, old_on_hand, new_on_hand, received_at) \"\n            \"VALUES (?, ?, ?, ?)\",\n            (sku, old[\"on_hand\"] if old else None, on_hand, now))"
          },
          {
            "claim": 5,
            "supported": true,
            "quote": "def sync_history(conn: sqlite3.Connection, sku: str, limit: int) -> list[dict]:\n    \"\"\"Return the latest changes for a SKU, newest first.\"\"\"\n    rows = conn.execute(\n        \"SELECT sku, old_on_hand, new_on_hand, received_at FROM sync_log \"\n        \"WHERE sku = ? ORDER BY id DESC LIMIT ?\", (sku, limit))"
          }
        ],
